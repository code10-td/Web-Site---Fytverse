import cv2
import numpy as np
import matplotlib.pyplot as plt
from skimage.measure import label, regionprops

# Read image
image = cv2.imread("/content/rice.tiff", cv2.IMREAD_GRAYSCALE)

# Display original image
plt.figure()
plt.imshow(image, cmap="gray")
plt.title("Original Rice Image")
plt.axis("off")
plt.show()

# Thresholding
_, binary = cv2.threshold(image, 0, 255,
                          cv2.THRESH_BINARY + cv2.THRESH_OTSU)

# Display binary image
plt.figure()
plt.imshow(binary, cmap="gray")
plt.title("Binary Image")
plt.axis("off")
plt.show()

# Label connected components
labeled_image = label(binary > 0)

# Measure properties
regions = regionprops(labeled_image)

# Count rice
print("Number of rice:", len(regions))

# Display measurements
for i, region in enumerate(regions, start=1):
    print(
        f"Rice {i}: "
        f"Area = {region.area}, "
        f"Major Axis Length = {region.major_axis_length:.2f}, "
        f"Perimeter = {region.perimeter:.2f}"
    )

# Specific area range
print("\nRice with area between 100 and 300:")

for i, region in enumerate(regions, start=1):
    if 100 <= region.area <= 300:
        print(f"Rice {i}: Area = {region.area}")
